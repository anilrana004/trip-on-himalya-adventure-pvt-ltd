# Copy to a real environment (Railway / shell). Spring does NOT read backend/src/.env.
# Keep secrets out of git.

DB_URL=jdbc:postgresql://127.0.0.1:5432/securetravels_crm
DB_USER=postgres
DB_PASSWORD=postgres
SPRING_PROFILES_ACTIVE=dev
APP_PUBLIC_URL=http://localhost:3001

# Required on prod / Railway (boot refuses defaults and blank webhook secrets)
# JWT_SECRET=
# WEBHOOK_SECRET=
# EMAIL_WEBHOOK_SECRET=
# SMS_WEBHOOK_SECRET=
# CORS_ALLOWED_ORIGINS=https://app.example.com
# COOKIE_SECURE=true
# APP_PUBLIC_URL=https://app.example.com

# Optional integrations
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_IDS=
# META_WEBHOOK_VERIFY_TOKEN=
# INTERAKT_API_KEY=
# INTERAKT_WEBHOOK_SECRET=
# WHATSAPP_MODE=SANDBOX
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=securetravels-documents
# FINANCE_BOOTSTRAP_PASSWORD=
