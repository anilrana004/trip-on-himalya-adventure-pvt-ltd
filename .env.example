# Railway → API service → Variables → Raw Editor: paste, fill secrets, save, redeploy.
# Never commit real values. Generate with: ops/gen-prod-secrets.ps1

# ── Required for CRM + Finance ERP + webhooks (boot refuses without these) ──
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=
WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=
SMS_WEBHOOK_SECRET=
CORS_ALLOWED_ORIGINS=https://YOUR-APP.vercel.app

# ── Recommended ─────────────────────────────────────────────────────────────
APP_PUBLIC_URL=https://YOUR-APP.vercel.app
# Sibling customer storefront origin (separate Vercel project). Merged into CORS.
STOREFRONT_PUBLIC_URL=https://YOUR-STORE.vercel.app
BOOTSTRAP_ADMIN_EMAIL=ceo@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=
FINANCE_BOOTSTRAP_PASSWORD=
MESSAGING_MODE=INLINE
WHATSAPP_MODE=SANDBOX

# CRM lifecycle alerts (lead / SLA / quote / book) → Slack/Gmail via Catch Hook.
# See docs/deployment/EVENTS_ZAPIER.md
# ZAPIER_EVENTS_HOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Bulk email campaigns (Leads → Email campaign). Catch Hook HTTPS URL.
# See docs/deployment/EMAIL_ZAPIER.md
# ZAPIER_EMAIL_HOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Bulk WhatsApp campaigns (Leads → WhatsApp campaign). Catch Hook HTTPS URL.
# See docs/deployment/WHATSAPP_ZAPIER.md
# ZAPIER_WHATSAPP_HOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Leave empty while Vercel proxies /api (refresh cookie stays on the app host).
# COOKIE_DOMAIN=
