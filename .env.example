# Railway → API service → Variables → Raw Editor: paste, fill secrets, save, redeploy.
# Never commit real values. Generate with: ops/gen-prod-secrets.ps1

# ── Required for CRM + Finance ERP + webhooks (boot refuses without these) ──
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=
WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=
SMS_WEBHOOK_SECRET=
CORS_ALLOWED_ORIGINS=https://YOUR-APP.vercel.app

# ── Recommended ─────────────────────────────────────────────────────────────
APP_PUBLIC_URL=https://YOUR-APP.vercel.app
# Sibling customer storefront origin (separate Vercel project). Merged into CORS.
STOREFRONT_PUBLIC_URL=https://YOUR-STORE.vercel.app
BOOTSTRAP_ADMIN_EMAIL=ceo@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=
FINANCE_BOOTSTRAP_PASSWORD=
MESSAGING_MODE=INLINE
WHATSAPP_MODE=SANDBOX

# CRM lifecycle alerts Catch Hook (rollback). Cutover default: posts paused.
# Keep URL; set true only to re-enable Zapier Slack/Gmail.
# ZAPIER_EVENTS_HOOK_URL=https://hooks.zapier.com/hooks/catch/...
# ZAPIER_EVENTS_ENABLED=false

# Bulk email / WhatsApp: desk default is INLINE (SendGate). Catch Hooks optional rollback.
# See docs/deployment/EMAIL_ZAPIER.md and WHATSAPP_ZAPIER.md
# ZAPIER_EMAIL_HOOK_URL=https://hooks.zapier.com/hooks/catch/...
# ZAPIER_WHATSAPP_HOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Near-departure document chase window (days). Default 21.
# COMPLIANCE_DOC_REMINDER_LEAD_DAYS=21

# Razorpay payment webhook (CORE). HMAC over raw body; header X-Razorpay-Signature.
# Match payments.gateway_ref to the Razorpay payment id.
# RAZORPAY_WEBHOOK_SECRET=

# Meta Lead Ads native webhook (ADR 0008). Default false = ack only.
# Pause the Facebook Lead Ads Zap in Zapier UI before enabling ingest.
# META_LEADGEN_INGEST_ENABLED=false
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=

# Automation cutover (approved): engine M1–M13 live; hard-coded MIGRATE effects off.
# AUTOMATION_MIGRATE_SHADOW_ENABLED=true
# AUTOMATION_DRY_RUN_ENABLED=false
# AUTOMATION_LEGACY_EFFECTS_ENABLED=false
# Rollback MIGRATE: AUTOMATION_LEGACY_EFFECTS_ENABLED=true (+ optional DRY_RUN=true)

# AI messaging agent (M12/M13). STUB = deterministic copy, no key. OPENAI needs API key.
# Sends only when email/WhatsApp channel is workable (SANDBOX or live credentials).
# AI_AGENT_ENABLED=true
# AI_AGENT_PROVIDER=STUB
# AI_AGENT_API_KEY=
# AI_AGENT_MODEL=gpt-4o-mini
# AI_AGENT_BASE_URL=https://api.openai.com/v1

# Leave empty while Vercel proxies /api (refresh cookie stays on the app host).
# COOKIE_DOMAIN=
