# Copy values into Railway / Vercel dashboards — never commit real secrets.

# ── Railway: Postgres (from the Postgres plugin) ─────────────────────────────
# DB_URL=jdbc:postgresql://HOST:PORT/DATABASE
# DB_USER=...
# DB_PASSWORD=...

# ── Railway: backend service ─────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://HOST:PORT/DATABASE
DB_USER=
DB_PASSWORD=
JWT_SECRET=          # openssl rand -base64 48
WEBHOOK_SECRET=      # openssl rand -base64 32
EMAIL_WEBHOOK_SECRET= # required in prod; unsigned email webhooks are rejected
SMS_WEBHOOK_SECRET=   # required in prod; unsigned SMS webhooks are rejected
CORS_ALLOWED_ORIGINS=https://app.YOURDOMAIN
# Leave COOKIE_DOMAIN empty while Next.js proxies /api. SameSite=Lax is the default.
# COOKIE_SAMESITE=Lax
# COOKIE_SECURE=false   # leave false; Secure is set when the request is HTTPS
BOOTSTRAP_ADMIN_EMAIL=ceo@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=   # strong; remove after first login
FINANCE_BOOTSTRAP_PASSWORD= # strong; required in prod to create finance user
MESSAGING_MODE=INLINE
WHATSAPP_MODE=SANDBOX

# ── Vercel: frontend (Root Directory = frontend) ─────────────────────────────
API_PROXY_TARGET=https://YOUR-BACKEND.up.railway.app
# Do NOT set NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS in production.

# ── Railway: Meta Marketing API (ADR 0008) — server only, never on Vercel ─────
# Required for Ads UI:
# META_ACCESS_TOKEN=          # Business system-user token (rotate if exposed)
#   Campaigns/insights need ads_read or ads_management.
#   Lead fetch needs leads_retrieval. Those are checked separately.
# Required for Lead Ads webhook:
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=  # Meta app → Webhooks → Verify Token
# Optional:
# META_APP_ID=                # ops only; not required by Graph client
# META_GRAPH_VERSION=v22.0
# META_AD_ACCOUNT_IDS=        # comma-separated act_… allowlist
# Callback URL (after Railway public domain exists):
#   https://YOUR-BACKEND.up.railway.app/api/webhook/meta
# Subscribe object: page · field: leadgen · then subscribe the Page.
# Full ops checklist + Phase 9 deploy plan: docs/META_MARKETING_ACCESS.md §§3,7–8
# Health: Railway healthcheckPath=/actuator/health (also /api/health if enabled).
